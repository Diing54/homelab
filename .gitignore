# keep secrets out of git
**/.env
*.key
*.pem
secrets/

# ignore local app state and databases
**/data/
*.sqlite3
*.sqlite3-*
*.db

# keep disaster recovery payloads local
backups/

# logs and caching
**/logs/
*.log
tmp/

# editor temp files (vim, nano)
*~
*.swp

# paperless-ngx specific directories
**/media/
**/consume/
**/export/
**/pgdata/

# pihole specific state directories
**/etc-pihole/
**/etc-dnsmasq.d/
